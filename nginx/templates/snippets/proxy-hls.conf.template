# HLS(/stream) 공통 프록시 설정 (PRD §3.3, §4)
# 캐시 유효 시간(proxy_cache_valid)은 location마다 다르므로 포함하는 쪽에서 지정한다.
# 404/5xx는 proxy_cache_valid에 없어 캐시되지 않는다.
# 주의: add_header는 location 단위로 상속이 끊긴다. 이 스니펫의 add_header는 모두 location 수준에 있고,
#       OPTIONS 처리용 if 블록에는 add_header를 두지 않아 같은 헤더(always 포함)를 상속받는다.
#       보안 헤더 include(security-headers)는 이 스니펫 맨 아래 add_header 묶음 뒤에 있다(if 블록 밖).

# 읽기 전용 메서드만 허용한다 (POST 등은 403)
limit_except GET HEAD OPTIONS {
    deny all;
}

# CORS 프리플라이트: rewrite보다 먼저 실행되도록 앞에 둔다.
# if 안에 add_header가 없으므로 아래 location 수준의 add_header를 그대로 상속한다.
if ($request_method = OPTIONS) {
    return 204;
}

rewrite ^/stream/(.*)$ /${STORAGE_BUCKET_NAME}/hls/$1 break;
proxy_pass http://s3_storage;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host ${STORAGE_HOST_HEADER};
# 클라이언트 인증 헤더는 RustFS(익명 읽기)로 전달하지 않는다
proxy_set_header Authorization "";

# stream과 artwork가 hls_cache 존을 공유한다. rewrite 후 $uri(/버킷/hls/...)라 artwork(/artwork/...)와 키가 겹치지 않는다
proxy_cache hls_cache;
proxy_cache_key "$uri";
proxy_cache_lock on;

# 오류 응답(404/502 등)에도 붙도록 always를 쓴다. 캐시 관련 Cache-Control은 여기서 추가하지 않는다.
add_header X-Cache-Status $upstream_cache_status always;
add_header Access-Control-Allow-Origin * always;
add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
add_header Access-Control-Allow-Headers "Range, Origin, Accept, Content-Type" always;
add_header Access-Control-Expose-Headers "Content-Length, Content-Range" always;
# 보안 헤더 (if 블록 밖, location 수준)
include /etc/nginx/snippets/security-headers.conf;
