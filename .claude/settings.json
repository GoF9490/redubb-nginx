{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose config *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker exec nginx-proxy nginx -t)",
      "Bash(docker logs nginx-proxy *)",
      "Bash(curl *http://localhost*)",
      "Bash(bash -n *)",
      "Bash(sh -n *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(docker compose config *)",
      "PowerShell(docker compose ps *)",
      "PowerShell(docker compose logs *)",
      "PowerShell(docker exec nginx-proxy nginx -t)",
      "PowerShell(docker logs nginx-proxy *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(./.env.development)",
      "Read(**/.env.development)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*.json)",
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git rebase *)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(docker compose down --volumes*)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker volume prune*)",
      "PowerShell(docker system prune*)",
      "PowerShell(Format-Volume *)"
    ]
  }
}
