{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "PowerShell(npm run test)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run build)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx playwright test *)",
      "PowerShell(npx tsc --noEmit)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/application-secret*.yaml)",
      "Read(**/credentials*.json)",
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git rebase *)",
      "PowerShell(Format-Volume *)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true
  }
}
