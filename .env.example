# 통합 docker 스택 환경변수 예시 (PRD §5.3)
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 .gitignore 대상이며 커밋하지 않습니다.
# 아래 값은 모두 예시이며 실제 시크릿이 아닙니다.

# ---------------------------------------------------------------------------
# PostgreSQL (PRD-07 §7)
# ---------------------------------------------------------------------------
DB_NAME=streaming_db
DB_USERNAME=streaming_user
# 시크릿: 반드시 교체합니다.
DB_PASSWORD=local_secret_pw_123!

# ---------------------------------------------------------------------------
# Google OAuth2 (시크릿: Google Cloud Console 발급값으로 교체)
# 승인된 리디렉션 URI: http://localhost/login/oauth2/code/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------------------------------------------------------------------------
# JWT (시크릿)
# UTF-8 기준 32바이트 이상이어야 합니다. 미만이면 백엔드 기동에 실패합니다.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-bytes

# ---------------------------------------------------------------------------
# RustFS (PRD-06 §3 Step 1)
# 시크릿 키는 8자 이상이어야 합니다.
# ---------------------------------------------------------------------------
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfs_secret_key_123!

# ---------------------------------------------------------------------------
# 스토리지 연결
# 주의: STORAGE_ENDPOINT 의 host:port 와 STORAGE_HOST_HEADER 는 반드시 동일해야 합니다.
#       (presigned URL 서명 검증이 Host 헤더 기준이라 다르면 원본 다운로드가 403입니다.)
#       예) STORAGE_ENDPOINT=http://rustfs:9000  <->  STORAGE_HOST_HEADER=rustfs:9000
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_HOST_HEADER=rustfs:9000
STORAGE_UPSTREAM=rustfs:9000
STORAGE_BUCKET_NAME=audio-storage

# ---------------------------------------------------------------------------
# 백엔드 upstream (Nginx 라운드로빈 대상)
# ---------------------------------------------------------------------------
BACKEND_UPSTREAM_1=web-server-1:8080
BACKEND_UPSTREAM_2=web-server-2:8080
# 백엔드 이미지는 백엔드 저장소가 빌드합니다. 이 저장소에서는 빌드하지 않습니다.
BACKEND_IMAGE=music-backend:latest

# ---------------------------------------------------------------------------
# 프론트엔드 정적 파일 (프론트엔드 저장소의 npm run build 출력 위치)
# ---------------------------------------------------------------------------
FRONTEND_DIST_DIR=../frontend-dist

# ---------------------------------------------------------------------------
# OAuth2 리디렉션 (운영 기본값)
# 개발 서버 로그인용 http://localhost:5173/auth/callback 은 개발용 .env 에서만
# OAUTH2_ALLOWED_REDIRECT_URIS 끝에 추가하고, 운영에는 넣지 않습니다.
#   예) OAUTH2_ALLOWED_REDIRECT_URIS=http://localhost/auth/callback,musicapp://oauth2/callback,http://localhost:5173/auth/callback
# ---------------------------------------------------------------------------
OAUTH2_DEFAULT_REDIRECT_URI=http://localhost/auth/callback
OAUTH2_ALLOWED_REDIRECT_URIS=http://localhost/auth/callback,musicapp://oauth2/callback

# ---------------------------------------------------------------------------
# 미디어/CORS (단일 오리진 구성에서는 빈 값)
# 분리 배포 예) MEDIA_PUBLIC_BASE_URL=https://media.example.com
#              CORS_ALLOWED_ORIGINS=https://web.example.com
# ---------------------------------------------------------------------------
MEDIA_PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# 선택 변수 (기본값 사용 시 생략 가능, 값은 PRD-05 §4.3 기본값)
# MAX_REQUEST_SIZE 는 Nginx client_max_body_size 110M 과 같아야 합니다.
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE=100MB
MAX_REQUEST_SIZE=110MB
JWT_EXPIRATION_MS=86400000
STORAGE_PRESIGNED_EXPIRY_SECONDS=60
STORAGE_REGION=us-east-1
FFMPEG_TIMEOUT_MINUTES=3
